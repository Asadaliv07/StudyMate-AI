# StudyMate AI - Environment Configuration Example
# Copy this file to .env and add your private API key:
# cp .env.example .env

# Google Gemini API Key
# Obtain a free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Multi-Key Pool (Optional: comma-separated list of keys for round-robin load distribution & rate-limit failover)
GEMINI_API_KEYS=your_gemini_api_key_here

# Optional: AI Model Configuration (defaults to gemini-3.5-flash-lite)
# Supported models: gemini-3.5-flash-lite, gemini-3.5-flash, gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Server Port (defaults to 5173 for Vite dev server)
PORT=5173
